# The API origin the browser calls.
#
# Read at BUILD time, not runtime — changing it in Vercel requires a redeploy,
# not just a restart.
#
# Local development:
NEXT_PUBLIC_API_URL=https://sci-server.vercel.app/api/v1

# Production (set in the Vercel dashboard, not here):
# NEXT_PUBLIC_API_URL=https://your-backend.vercel.app/api/v1
